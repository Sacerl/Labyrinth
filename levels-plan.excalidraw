oughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1298915976, "version": 1, "versionNonce": 721621762, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "1 2 3", "originalText": "1 2 3", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e863", "type": "text", "x": 2710, "y": 387, "width": 325.6, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1297994039, "version": 1, "versionNonce": 544418470, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Reihenfolge: sehen → holen → benutzen", "originalText": "Reihenfolge: sehen → holen → benutzen", "fontSize": 16, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e864", "type": "text", "x": 2640, "y": 440, "width": 79.2, "height": 30.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 642076825, "version": 1, "versionNonce": 716963011, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Kamera", "originalText": "Kamera", "fontSize": 24, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e865", "type": "text", "x": 2640, "y": 478, "width": 440.00000000000006, "height": 80.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1965737515, "version": 1, "versionNonce": 653853960, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Level-Start: Kamera zeigt kurz das ganze Labyrinth\nund zoomt dann auf den Spieler (5×3 Felder).\nNur in diesem Moment sieht man alles – merken!\nDie Kamera stoppt am Rand des Labyrinths.", "originalText": "Level-Start: Kamera zeigt kurz das ganze Labyrinth\nund zoomt dann auf den Spieler (5×3 Felder).\nNur in diesem Moment sieht man alles – merken!\nDie Kamera stoppt am Rand des Labyrinths.", "fontSize": 16, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e866", "type": "text", "x": 2640, "y": 600, "width": 462.00000000000006, "height": 30.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 580641105, "version": 1, "versionNonce": 691982720, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Progression: erst sehen, dann holen", "originalText": "Progression: erst sehen, dann holen", "fontSize": 24, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e867", "type": "text", "x": 2640, "y": 638, "width": 554.4000000000001, "height": 280.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 342261016, "version": 1, "versionNonce": 1090419375, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Tutorial: bewegen, Patrouille, ♥, erster Kampf, Kiste schieben.\n1 Schlüssel: verschlossene Tür → Schlüssel in der Sackgasse\n   direkt daneben → zurück zur Tür.\n2 Handschuh: Kiste steckt in Sackgasse fest, Tor ist zu →\n   neben dem Tor liegt der Handschuh (Ziehen) → zurück,\n   Kiste rausziehen → auf die Druckplatte.\n3 Hebel: Wand A sperrt → Hebel in einer Sackgasse abseits\n   (B schließt das ♥!), dazu zwei Türen (gelb → blau).\nAb Level 3 liegt die Lösung außer Sicht und weiter weg:\n   lange Sackgasse statt direkt neben dem Hindernis.\n4 Schild: zwei Kämpfe ohne Schild, dann liegt er im Gang,\n   der nächste Kampf ist die Übungsrunde.\n5 Finale: alles kombiniert + Doppelkampf (!) vor dem Ziel.\nFähigkeiten bleiben für alle späteren Level.", "originalText": "Tutorial: bewegen, Patrouille, ♥, erster Kampf, Kiste schieben.\n1 Schlüssel: verschlossene Tür → Schlüssel in der Sackgasse\n   direkt daneben → zurück zur Tür.\n2 Handschuh: Kiste steckt in Sackgasse fest, Tor ist zu →\n   neben dem Tor liegt der Handschuh (Ziehen) → zurück,\n   Kiste rausziehen → auf die Druckplatte.\n3 Hebel: Wand A sperrt → Hebel in einer Sackgasse abseits\n   (B schließt das ♥!), dazu zwei Türen (gelb → blau).\nAb Level 3 liegt die Lösung außer Sicht und weiter weg:\n   lange Sackgasse statt direkt neben dem Hindernis.\n4 Schild: zwei Kämpfe ohne Schild, dann liegt er im Gang,\n   der nächste Kampf ist die Übungsrunde.\n5 Finale: alles kombiniert + Doppelkampf (!) vor dem Ziel.\nFähigkeiten bleiben für alle späteren Level.", "fontSize": 16, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e868", "type": "text", "x": 3200, "y": -60, "width": 369.6, "height": 30.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1011157170, "version": 1, "versionNonce": 1528804739, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "★ Begegnung = Ausweich-Kampf", "originalText": "★ Begegnung = Ausweich-Kampf", "fontSize": 24, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e869", "type": "rectangle", "x": 3200, "y": -15, "width": 300, "height": 170, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1353828268, "version": 1, "versionNonce": 736772037, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e870", "type": "rectangle", "x": 3212, "y": -3, "width": 276, "height": 146, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1190918961, "version": 1, "versionNonce": 2031801349, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e871", "type": "text", "x": 3342.85, "y": 63.75, "width": 14.3, "height": 32.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1330324572, "version": 1, "versionNonce": 331840958, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "♥", "originalText": "♥", "fontSize": 26, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e872", "type": "ellipse", "x": 3235.0, "y": 20.0, "width": 10, "height": 10, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "#ffffff", "fillStyle